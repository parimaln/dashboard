# Generated by `npm run gen:env` from the component manifests. Do not edit by hand.
#
# Copy to .env and fill in. This file holds every secret and every LAN address:
# it is gitignored, it is never baked into the published image, and none of it
# is ever sent to the browser.

# Timezone for the container itself; the dashboard uses config/public.json.
TZ=Europe/Oslo

# --- core ----------------------------------------------------------------
# HTTP port to listen on (default 8080).
# PORT=

# Interface to bind (default 0.0.0.0).
# HOST=

# Path to public.json (default ./config/public.json).
# CONFIG_PATH=

# Set to 1 to serve fixture data instead of calling any upstream. Used by
# tests.
# MOCK=

# error | warn | info | debug (default info).
# LOG_LEVEL=

# Path to the built client, relative to the working directory (default
# dist/client).
# CLIENT_DIR=

# --- ai-briefing ---------------------------------------------------------
# An OpenAI-compatible /v1 endpoint. Ollama: http://host:11434/v1. LM Studio:
# http://host:1234/v1. Also works with vLLM, llama.cpp, OpenRouter or OpenAI
# itself.
AI_BASE_URL=

# Model id as that server names it, e.g. qwen2.5:14b-instruct.
AI_MODEL=

# Sent as the bearer token. Local servers ignore it; set it for hosted
# providers.
# AI_API_KEY=

# Override the system prompt file. Defaults to prompts/briefing.md in the
# image.
# AI_PROMPT_PATH=

# Override the standing household notes file. Defaults to config/household.md.
# See config/household.example.md for what to put in it.
# HOUSEHOLD_PATH=

# --- calendar-ics --------------------------------------------------------
# Comma-separated list of "url|Label|#colour". In Google Calendar use Settings
# → the calendar → "Secret address in iCal format". Treat these URLs as
# passwords: anyone holding one can read that calendar.
CALENDAR_ICS_URLS=

# --- countdown -----------------------------------------------------------
# Override the path to the events file. Useful for mounting a file you edit
# outside the image.
# COUNTDOWN_EVENTS_PATH=

# --- donetick ------------------------------------------------------------
# Base URL of your Donetick instance on the LAN, e.g. http://donetick.lan:2021
# (no trailing slash).
DONETICK_BASE_URL=

# A Donetick access token. Settings → Access Tokens. Sent in the `secretkey`
# header.
DONETICK_TOKEN=

# --- entur ---------------------------------------------------------------
# Identifier sent to Entur as ET-Client-Name, e.g. "surname-dashboard". Entur
# asks all clients to identify themselves. No account or key is needed.
# ENTUR_CLIENT_NAME=

# --- mealie --------------------------------------------------------------
# Base URL of your Mealie instance on the LAN, e.g. http://mealie.lan:9000 (no
# trailing slash).
MEALIE_BASE_URL=

# Long-lived API token from Mealie under Profile → API Tokens.
MEALIE_TOKEN=

# --- weather-yr ----------------------------------------------------------
# Contact address sent to met.no, e.g. "you@example.com". Their terms of
# service require identifying your client; anonymous clients can be blocked.
# MET_USER_AGENT=

# Optional label shown next to the temperature. Defaults to the global
# `place`.
# WEATHER_PLACE=
